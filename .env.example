# Copier ce fichier en ".env" et renseigner votre clé (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modèle utilisé pour générer les recettes
# claude-opus-5-5 (meilleure qualité) | claude-sonnet-5-5 | claude-haiku-5-5 (le moins cher)
CLAUDE_MODEL=claude-opus-5-5

# Port du serveur local
PORT=3000
